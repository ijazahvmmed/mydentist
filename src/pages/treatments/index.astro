---
import EditorialMedia from '../../components/common/EditorialMedia.astro';
import ServiceFamilies from '../../components/common/ServiceFamilies.astro';
import { serviceCatalog } from '../../lib/schema';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/common/Breadcrumbs.astro';
import Arrow from '../../components/common/Arrow.astro';
import { content } from '../../lib/content/repository';
const [treatments, categories, services] = await Promise.all([
  content.getTreatments(),
  content.getServiceCategories(),
  content.getServices(),
]);
---

<Base
  title="Dental Treatments | Dr Kiran’s MyDentist"
  description="Explore restorative and endodontic care, surgical and periodontal care, orthodontics and pediatric dentistry at Dr Kiran’s MyDentist."
  schema={serviceCatalog(categories, services, Astro.site)}
>
  <Breadcrumbs items={[{ name: 'Treatments', path: '/treatments/' }]} />
  <section class="page-hero wrap treatment-index-hero">
    <div>
      <span class="eyebrow">UNDERSTAND YOUR OPTIONS</span>
      <h1>
        Explore
        <br />
        our services.
      </h1>
      <p>
        Care across restorative dentistry, surgery, orthodontics and pediatric dentistry. Explore
        the options, then discuss an individual plan with your dentist.
      </p>
    </div>
    <EditorialMedia
      asset="smile-closeup"
      class="smile-media"
      sizes="(max-width: 700px) 100vw, 38vw"
      motion="horizontal"
    />
  </section>
  <nav class="service-family-nav wrap" aria-label="Service families">
    {categories.map((category) => (
      <a href={`#${category.id}`}>
        <span>{category.number}</span>
        {category.name}
        <Arrow diagonal />
      </a>
    ))}
  </nav>
  <section class="treatment-directory wrap" aria-label="Dental service families">
    <ServiceFamilies categories={categories} services={services} />
  </section>
  <section class="related wrap service-guides">
    <span class="eyebrow">KEEP EXPLORING</span>
    <h2>In-depth treatment guides.</h2>
    <div class="related-links">
      {treatments.map((t) => (
        <a href={`/treatments/${t.slug}/`}>
          {t.name}
          <Arrow diagonal />
        </a>
      ))}
    </div>
    <p class="info-note">
      Treatment availability and suitability are discussed with your chosen clinic.
    </p>
  </section>
</Base>
