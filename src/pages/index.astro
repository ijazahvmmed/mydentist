---
import Icon from '../components/common/Icon.astro';
import Base from '../layouts/Base.astro';
import Arrow from '../components/common/Arrow.astro';
import ToothScene from '../components/three/ToothScene';
import EditorialMedia from '../components/common/EditorialMedia.astro';
import BrandRibbon from '../components/common/BrandRibbon.astro';
import CareNetwork from '../components/home/CareNetwork.astro';
import ServiceChapters from '../components/home/ServiceChapters.astro';
import PriorityCare from '../components/home/PriorityCare.astro';
import WhyChoose from '../components/home/WhyChoose.astro';
import AdvancedTechnology from '../components/home/AdvancedTechnology.astro';
import ToothStory from '../components/home/ToothStory.astro';
import BranchFinder from '../components/locations/BranchFinder.astro';
import FAQs from '../components/common/FAQs.astro';
import { content } from '../lib/content/repository';
import { createWhatsAppUrl } from '../lib/whatsapp';
import { organization, website } from '../lib/schema';
// Keep the tooth story available to restore without loading its scene on the homepage.
const showToothStory = false;
const [branches, treatments, allFAQs, categories, services, technologies, trustPoints] =
  await Promise.all([
    content.getBranches(),
    content.getTreatments(),
    content.getFAQs(),
    content.getServiceCategories(),
    content.getServices(),
    content.getTechnologies(),
    content.getTrustPoints(),
  ]);
const homeFAQs = allFAQs.filter((faq) =>
  [
    'locations',
    'contact',
    'sunday',
    'treatment',
    'opg',
    'cbct',
    'intraoral-scanner',
    'children-treatments',
  ].includes(faq.id)
);
---

<Base
  title="Dr Kiran’s MyDentist | Advanced Dental Care in Alappuzha"
  description="15 years of dental care across six MyDentist clinic locations in Alappuzha. Explore Root Canal Therapy, implants, orthodontics, pediatric care and advanced dental imaging."
  schema={[organization(Astro.site), website(Astro.site)]}
  pageClass="home-campaign"
>
  <section class="hero hero-photographic wrap">
    <div class="hero-topline">
      <span>
        <i></i> DENTAL CARE, A LITTLE CLOSER.
      </span>
      <span>
        <Icon name="pin" /> ALAPPUZHA, KERALA
      </span>
    </div>
    <div class="hero-main">
      <div class="hero-copy">
        <h1>
          Modern <br />
          dentistry.
          <br />
          <span>Closer to you.</span>
        </h1>
        <p>
          15 years of dental care. Six clinic locations.
          <br />
          Find your MyDentist in Alappuzha.
        </p>
        <div class="hero-actions">
          <a class="button" href="#clinics">
            <span class="action-label">
              <Icon name="pin" />
              Find a clinic
            </span>
            <Arrow diagonal />
          </a>
          <a class="text-link" href={createWhatsAppUrl()} data-event="whatsapp_click">
            <span class="action-label">
              <Icon name="chat" />
              WhatsApp us
            </span>
            <Arrow diagonal />
          </a>
        </div>
      </div>
      <div class="hero-media">
        <picture class="hero-artwork">
          <source
            type="image/avif"
            srcset="/images/hero/dental-care-640.avif 640w, /images/hero/dental-care-960.avif 960w, /images/hero/dental-care-1440.avif 1440w, /images/hero/dental-care-1920.avif 1920w"
            sizes="(max-width: 700px) 100vw, 85vw"
          />
          <source
            type="image/webp"
            srcset="/images/hero/dental-care-640.webp 640w, /images/hero/dental-care-960.webp 960w, /images/hero/dental-care-1440.webp 1440w, /images/hero/dental-care-1920.webp 1920w"
            sizes="(max-width: 700px) 100vw, 85vw"
          />
          <img
            src="/images/hero/dental-care-1920.webp"
            alt="A patient receiving a dental examination with a mirror and blue-gloved hands"
            width="2400"
            height="1600"
            fetchpriority="high"
          />
        </picture>
        <a class="hero-study" href={showToothStory ? '#tooth-story' : '/treatments/'}>
          <span class="study-icon" aria-hidden="true">
            <Icon name="tooth" />
          </span>
          <span>
            {showToothStory ? 'Understand your tooth' : 'Explore your care'}
            <small>{showToothStory ? 'EXPLORE THE STORY' : 'TREATMENT GUIDES'}</small>
          </span>
          <Arrow diagonal />
        </a>
      </div>
    </div>
    <div class="hero-bottom">
      <div class="clinic-signal">
        <button
          class="clinic-spark"
          type="button"
          aria-label="06 â€” Celebrate six neighbourhood clinics"
        >
          06
        </button>
        <p>
          Neighbourhood clinics.
          <br />
          One MyDentist.
        </p>
      </div>
      <div class="hero-locations">
        Thuravoor · Poochakkal · Eramalloor
        <br />
        Thirunalloor · Aroor · Vaduthala
      </div>
      <a href={showToothStory ? '#tooth-story' : '#life'} class="scroll-link">
        SCROLL TO DISCOVER <Icon name="down" />
      </a>
    </div>
  </section>
  {showToothStory && (
    <>
      <ToothScene client:idle />
      <ToothStory />
    </>
  )}
  <section class="life-chapter" id="life" aria-labelledby="life-heading">
    <EditorialMedia
      asset="lifestyle-at-home-client"
      class="life-media"
      sizes="(max-width: 700px) 100vw, (max-width: 1456px) 53vw, 720px"
      motion="cinematic"
      position="50% 30%"
      mobilePosition="50% 40%"
    />
    <div class="life-copy wrap">
      <span class="eyebrow">YOUR LIFE. YOUR DENTAL CARE.</span>
      <h2 id="life-heading">
        Care should fit
        <br />
        back into life.
      </h2>
      <a class="text-link" href="/treatments/">
        Understand your options <Arrow diagonal />
      </a>
    </div>
  </section>
  <CareNetwork branches={branches} />
  <section class="services-campaign" aria-labelledby="services-heading">
    <div class="services-campaign-heading wrap">
      <span class="eyebrow">FOUR FAMILIES OF CARE</span>
      <h2 id="services-heading">
        Different needs.
        <br />
        Thoughtful care.
      </h2>
      <a class="text-link" href="/treatments/">
        Explore our services <Arrow diagonal />
      </a>
    </div>
    <ServiceChapters categories={categories} services={services} />
  </section>
  <PriorityCare treatments={treatments} />
  <WhyChoose points={trustPoints} />
  <AdvancedTechnology technologies={technologies} />
  <section class="conversation-chapter wrap" aria-labelledby="conversation-heading">
    <div class="conversation-heading">
      <span class="eyebrow">THE HUMAN PART OF CARE</span>
      <h2 id="conversation-heading">
        Better views.
        <br />
        Clearer conversations.
      </h2>
    </div>
    <EditorialMedia
      asset="consultation"
      class="conversation-media"
      sizes="(max-width: 700px) 100vw, 74vw"
      motion="cinematic"
    />
    <div class="conversation-copy">
      <p>
        Imaging and scanning support assessment. Your dentist explains what is relevant to your
        care.
      </p>
      <a class="text-link" href="/contact/">
        Make room for your questions <Arrow diagonal />
      </a>
    </div>
  </section>
  <section class="local-access-intro wrap" aria-labelledby="local-access-heading">
    <EditorialMedia
      asset="smile-macro-client"
      class="local-access-media"
      sizes="(max-width: 700px) 100vw, 50vw"
      motion="horizontal"
      position="32% 48%"
    />
    <div>
      <span class="eyebrow">YOUR NEIGHBOURHOOD. YOUR MYDENTIST.</span>
      <h2 id="local-access-heading">
        Care,
        <br />
        closer to home.
      </h2>
      <a class="text-link" href="#clinics">
        Find your neighbourhood <Arrow diagonal />
      </a>
    </div>
  </section>
  <div class="location-scene" data-location-surface>
    <BranchFinder branches={branches} />
  </div>
  <div class="quiet-questions">
    <FAQs items={homeFAQs} />
  </div>
  <section class="human-cta closing-frame wrap">
    <div class="editorial-copy">
      <span class="eyebrow">YOUR NEXT STEP</span>
      <h2>
        A conversation
        <br />
        comes first.
      </h2>
      <p>
        Need help finding the right clinic? Find your MyDentist in Alappuzha, or ask a question on
        WhatsApp.
      </p>
      <div class="hero-actions">
        <a class="button" href="/locations/">
          <span class="action-label">
            <Icon name="pin" />
            Find a clinic
          </span>
          <Arrow diagonal />
        </a>
        <a class="text-link" href={createWhatsAppUrl()} data-event="whatsapp_click">
          <span class="action-label">
            <Icon name="chat" />
            WhatsApp us
          </span>
          <Arrow diagonal />
        </a>
      </div>
    </div>
    <div class="portrait-media ribbon-stage ribbon-stage-portrait">
      <BrandRibbon id="portrait-ribbon" />
      <EditorialMedia asset="smiling-portrait" sizes="(max-width: 700px) 100vw, 38vw" />
    </div>
  </section>
</Base>
