---
import Icon from '../../components/common/Icon.astro';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/common/Breadcrumbs.astro';
import Arrow from '../../components/common/Arrow.astro';
---

<Base
  title="About Dr Kiran’s MyDentist | Six Local Dental Clinics"
  description="Get to know Dr Kiran’s MyDentist, with six clinic locations in Kerala and clear information to help you plan your dental visit."
>
  <Breadcrumbs items={[{ name: 'About', path: '/about/' }]} />
  <section class="page-hero wrap">
    <span class="eyebrow">DR KIRAN’S MYDENTIST</span>
    <h1>
      Closer to home.
      <br />
      Clearer about care.
    </h1>
  </section>
  <section class="wrap">
    <h2 class="about-statement">
      Dental care starts with a conversation. A question about your tooth. A treatment you want to
      understand. A clinic you can find.
    </h2>
    <div class="about-values">
      <div>
        <span class="section-cue">
          <Icon name="help" />
          <span class="eyebrow">01 / UNDERSTAND</span>
        </span>
        <h2>Room for your questions.</h2>
        <p>
          Explore plain-language treatment information before speaking with your dentist about your
          individual needs.
        </p>
      </div>
      <div>
        <span class="section-cue">
          <Icon name="pin" />
          <span class="eyebrow">02 / CONNECT</span>
        </span>
        <h2>Six places to begin.</h2>
        <p>
          Find MyDentist in Thuravoor, Poochakkal, Eramalloor, Thirunalloor, Aroor and Vaduthala.
        </p>
      </div>
      <div>
        <span class="section-cue">
          <Icon name="calendar" />
          <span class="eyebrow">03 / PLAN</span>
        </span>
        <h2>Your next step, made clear.</h2>
        <p>
          Check branch hours and contact the clinic by phone, or send a central WhatsApp enquiry.
        </p>
      </div>
    </div>
    <a class="text-link" href="/locations/">
      Explore our clinics <Arrow diagonal />
    </a>
  </section>
  <section class="prose wrap">
    <h2>The clinic network</h2>
    <p>
      Each of the six branches has a direct phone number and published opening hours. Contact your
      chosen clinic to discuss treatment arrangements and the team available for your visit.
    </p>
    <h2>Technology in the conversation</h2>
    <p>
      MyDentist’s confirmed technology includes intraoral scanning and OPG full-mouth imaging. Your
      dentist will decide whether a scan or X-ray is appropriate. Ask your branch about equipment
      availability.
    </p>
  </section>
</Base>
