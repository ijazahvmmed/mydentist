---
import EditorialMedia from '../../components/common/EditorialMedia.astro';
import Icon from '../../components/common/Icon.astro';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/common/Breadcrumbs.astro';
import Arrow from '../../components/common/Arrow.astro';
---

<Base
  title="About Dr Kiran’s MyDentist | Six Local Dental Clinics"
  description="Get to know Dr Kiran’s MyDentist, with six clinic locations in Kerala and clear information to help you plan your dental visit."
>
  <Breadcrumbs items={[{ name: 'About', path: '/about/' }]} />
  <section class="page-hero wrap">
    <span class="eyebrow">DR KIRAN’S MYDENTIST</span>
    <h1>
      Closer to home.
      <br />
      Clearer about care.
    </h1>
  </section>
  <section class="about-editorial-lead editorial-split wrap">
    <EditorialMedia
      asset="consultation"
      class="consultation-media"
      sizes="(max-width: 700px) 100vw, 50vw"
    />
    <div class="editorial-copy">
      <span class="eyebrow">ROOM FOR YOUR QUESTIONS</span>
      <h2>
        Dental care starts
        <br />
        with a conversation.
      </h2>
      <p>
        15 years of dental care. Six clinic locations across Alappuzha. A question about your tooth,
        a treatment you want to understand, and a local team to speak with.
      </p>
      <a class="text-link" href="/contact/">
        Talk to MyDentist <Arrow diagonal />
      </a>
    </div>
  </section>
  <section class="wrap">
    <div class="about-values">
      <div>
        <span class="section-cue">
          <Icon name="help" />
          <span class="eyebrow">01 / UNDERSTAND</span>
        </span>
        <h2>Room for your questions.</h2>
        <p>
          Explore plain-language treatment information before speaking with your dentist about your
          individual needs.
        </p>
      </div>
      <div>
        <span class="section-cue">
          <Icon name="pin" />
          <span class="eyebrow">02 / CONNECT</span>
        </span>
        <h2>Six places to begin.</h2>
        <p>
          Find MyDentist in Thuravoor, Poochakkal, Eramalloor, Thirunalloor, Aroor and Vaduthala.
        </p>
      </div>
      <div>
        <span class="section-cue">
          <Icon name="calendar" />
          <span class="eyebrow">03 / PLAN</span>
        </span>
        <h2>Your next step, made clear.</h2>
        <p>
          Check branch hours and contact the clinic by phone, or send a central WhatsApp enquiry.
        </p>
      </div>
    </div>
    <a class="text-link" href="/locations/">
      Explore our clinics <Arrow diagonal />
    </a>
  </section>
  <section class="environment-study wrap" aria-label="Illustrative care environments">
    <div class="environment-heading">
      <span class="eyebrow">A VISUAL STUDY OF CARE</span>
      <h2>
        Space. Detail.
        <br />A closer look.
      </h2>
      <p>
        Illustrative environments and clinical details. These images do not document our branches.
      </p>
    </div>
    <EditorialMedia
      asset="treatment-room"
      class="room-media"
      sizes="(max-width: 700px) 100vw, 55vw"
    />
    <EditorialMedia
      asset="dental-instruments"
      class="instruments-media"
      sizes="(max-width: 700px) 65vw, 24vw"
      motion="horizontal"
    />
  </section>
  <section class="prose wrap">
    <h2>The clinic network</h2>
    <p>
      Each of the six branches has a direct phone number and published opening hours. Contact your
      chosen clinic to discuss treatment arrangements and the team available for your visit.
    </p>
    <h2>Technology in the conversation</h2>
    <p>
      MyDentist’s confirmed technology includes intraoral scanning and OPG full-mouth imaging. Your
      dentist will decide whether a scan or X-ray is appropriate. Ask your branch about equipment
      availability.
    </p>
  </section>
  <section class="brand-atmosphere wrap">
    <div>
      <span class="eyebrow">MYDENTIST / BRAND STUDY</span>
      <h2>
        One MyDentist.
        <br />
        Six local clinics.
      </h2>
      <p>
        This reception image is an illustrative brand concept. For addresses, opening hours and
        contact details, explore the clinic directory.
      </p>
      <a class="text-link" href="/locations/">
        Find your clinic <Arrow diagonal />
      </a>
    </div>
    <EditorialMedia
      asset="reception"
      class="reception-media"
      sizes="(max-width: 700px) 100vw, 48vw"
    />
  </section>
</Base>
