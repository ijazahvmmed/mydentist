---
import type { Treatment } from '../../types/content';
import Arrow from '../common/Arrow.astro';
interface Props {
  treatments: Treatment[];
}
const { treatments } = Astro.props;
const selected = [
  'root-canal-treatment',
  'clear-aligners',
  'dental-implants',
  'wisdom-tooth-removal',
].map((id) => treatments.find((t) => t.id === id)!);
---

<section class="priority-care wrap treatments-home" aria-labelledby="priority-care-heading">
  <div class="priority-care-heading">
    <span class="eyebrow">A CLOSER LOOK</span>
    <h2 id="priority-care-heading">
      Understand
      <br />
      your next step.
    </h2>
    <a class="text-link" href="/treatments/">
      Explore the treatment guides <Arrow diagonal />
    </a>
  </div>
  <div class="priority-care-list treatment-rows">
    {selected.map((item, i) => (
      <a href={`/treatments/${item.slug}/`}>
        <span class="row-index">{String(i + 1).padStart(2, '0')}</span>
        <div>
          <h3>{item.name}</h3>
          <p>{item.summary}</p>
        </div>
        <Arrow diagonal />
      </a>
    ))}
  </div>
</section>
