---
import Arrow from '../common/Arrow.astro';

const chapters = [
  [
    'INSIDE THE TOOTH',

    'Every tooth has a story.',

    'The visible surface is only the beginning. Understanding a tooth can help make a treatment conversation clearer.',
  ],

  [
    'BEYOND THE SURFACE',

    'Small layers. Important roles.',

    'Enamel forms the outer surface. Dentin lies beneath it. At the centre, the pulp contains nerves and blood vessels.',
  ],

  [
    'WHEN PROBLEMS GO DEEPER',

    'Care begins with understanding.',

    'When the pulp becomes infected, your dentist may recommend root canal treatment. An assessment helps determine the right approach.',
  ],

  [
    'TREAT. RESTORE. PROTECT.',

    'A thoughtful next chapter.',

    'Treatment involves cleaning and filling the root canal system. Your dentist will discuss how the tooth should be restored afterwards.',
  ],
];
---

<section class="tooth-story" id="tooth-story" aria-label="Understanding root canal treatment">
  <div class="story-intro wrap">
    <span class="eyebrow">A CLOSER LOOK / ROOT CANAL THERAPY</span>

    <p>
      Understanding your care.
      <br />
      One layer at a time.
    </p>
  </div>

  <div class="story-stage">
    <div class="story-visual" aria-hidden="true">
      <img
        src="/images/treatments/tooth-hero.webp"

        alt=""

        width="1000"

        height="1000"

        loading="lazy"
      />

      <span class="visual-caption">TOOTH STUDY · ILLUSTRATIVE VISUAL</span>
    </div>

    <div class="story-text-viewport">
      <div class="story-chapters wrap">
        {chapters.map(([label, title, body], i) => (
          <article
            id={`tooth-chapter-${i + 1}`}
            class:list={['story-chapter', i % 2 === 0 ? 'copy-right' : 'copy-left']}
          >
            <div class="chapter-copy">
              <span class="eyebrow">
                <span class="chapter-number">0{i + 1}</span> / {label}
              </span>

              <h2>{title}</h2>

              <p>{body}</p>

              <img
                class="chapter-poster"

                src="/images/treatments/tooth-hero-640.webp"

                alt="Illustrative exterior of a tooth"

                width="640"

                height="640"

                loading="lazy"
              />

              {i === 3 && (
                <a class="text-link" href="/treatments/root-canal-treatment/">
                  Explore root canal treatment <Arrow diagonal />
                </a>
              )}

              <span class="chapter-progress" aria-hidden="true">
                {chapters.map((_, j) => (
                  <i class:list={{ active: i === j }} />
                ))}
              </span>
            </div>
          </article>
        ))}
      </div>
      <nav class="story-step-nav" aria-label="Tooth story chapters">
        {chapters.map(([label], i) => (
          <button
            type="button"
            data-story-step={i}
            aria-label={`0${i + 1} — ${label}`}
            aria-controls={`tooth-chapter-${i + 1}`}
          >
            0{i + 1}
          </button>
        ))}
      </nav>
    </div>
  </div>

  <p class="model-credit wrap">
    External surface study ·{' '}
    <a href="https://data.mendeley.com/datasets/xjsx7nfhj8/1">Díaz et al.</a> ·{' '}
    <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a> · Adapted for visualisation
  </p>
</section>

<script>
  import { gsap } from 'gsap';

  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const section = document.querySelector<HTMLElement>('.tooth-story');

  const visual = section?.querySelector<HTMLElement>('.story-visual');

  if (section && visual) {
    const mm = gsap.matchMedia();

    mm.add('(min-width: 900px) and (prefers-reduced-motion: no-preference)', () => {
      section.classList.add('motion-story');

      gsap.set(visual, { '--position': '50%' });

      const chapters = gsap.utils.toArray<HTMLElement>('.story-chapter');

      chapters.forEach((chapter, i) => {
        gsap.to(visual, {
          '--position': i % 2 === 0 ? '32%' : '68%',

          '--rotation': i % 2 === 0 ? '-5deg' : '5deg',

          '--scale': i === 2 ? 1.08 : 1,

          duration: 1,

          ease: 'sine.inOut',

          scrollTrigger: { trigger: chapter, start: 'top 85%', end: 'top 25%', scrub: 1 },
        });
      });

      return () => section.classList.remove('motion-story');
    });
  }
</script>
