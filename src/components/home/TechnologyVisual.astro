---
import TechnologyScene from '../three/TechnologyScene';
interface Props {
  kind: 'scan' | 'opg';
}
const { kind } = Astro.props;
---

<div
  class:list={[
    'digital-visual',
    'professional-visual',
    kind === 'opg' ? 'opg-visual' : 'arch-visual',
  ]}
  aria-hidden="true"
>
  <span class="visual-coordinate">
    {kind === 'scan' ? 'SURFACE ACQUISITION / 3D' : 'PANORAMIC STUDY / 180°'}
  </span>
  <img
    class:list={['study-poster', kind === 'scan' && 'scan-base']}
    src={`/images/technology/${kind === 'scan' ? 'arch' : 'opg'}-study.webp`}
    width="800"
    height="500"
    alt=""
    loading="lazy"
  />
  <TechnologyScene kind={kind} client:visible />
  <div class="scan-sweep"></div>
  <div class="visual-reticle" aria-hidden="true">
    <i></i>
    <i></i>
    <i></i>
    <i></i>
  </div>
  <span class="visual-mode">{kind === 'scan' ? '3D SURFACE VIEW' : 'PANORAMIC VIEW'}</span>
  <span class="visual-coordinate bottom">
    ILLUSTRATIVE VISUAL · {kind === 'scan' ? 'EXTERNAL SURFACES' : 'NOT A PATIENT RADIOGRAPH'}
  </span>
</div>
