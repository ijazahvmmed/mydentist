---
import type { MediaAsset } from '../../types/content';
import TechnologyScene from '../three/TechnologyScene';
interface Props {
  kind: 'scan' | 'opg' | 'cbct';
  media: MediaAsset;
}
const { kind, media } = Astro.props;
---

{kind === 'scan' ? (
  <div class="digital-visual professional-visual arch-visual" aria-hidden="true">
    <span class="visual-coordinate">SURFACE ACQUISITION / 3D</span>
    <img
      class="study-poster scan-base"
      src={media.src}
      width={media.width}
      height={media.height}
      alt=""
      loading="lazy"
    />
    <TechnologyScene client:visible />
    <div class="scan-sweep"></div>
    <div class="visual-reticle">
      <i></i>
      <i></i>
      <i></i>
      <i></i>
    </div>
    <span class="visual-mode">3D SURFACE VIEW</span>
    <span class="visual-coordinate bottom">ILLUSTRATIVE VISUAL · EXTERNAL SURFACES</span>
  </div>
) : (
  <div class:list={['digital-visual', 'imaging-visual', `${kind}-imaging-visual`]}>
    <span class="imaging-caption">
      {kind === 'opg' ? 'PANORAMIC DENTAL IMAGING / OPG' : 'DENTAL VOLUME / CBCT'}
    </span>
    <picture class="imaging-base">
      <source srcset={media.src.replace('.webp', '.avif')} type="image/avif" />
      <img
        src={media.src}
        width={media.width}
        height={media.height}
        alt={media.alt}
        loading="lazy"
        decoding="async"
      />
    </picture>
    {kind === 'opg' ? (
      <>
        <img
          class="radiograph-scan"
          src={media.src}
          width={media.width}
          height={media.height}
          alt=""
          loading="lazy"
          aria-hidden="true"
        />
        <span class="radiograph-band" aria-hidden="true"></span>
      </>
    ) : (
      <span class="cbct-slice" aria-hidden="true"></span>
    )}
    <span class="imaging-caption bottom">ILLUSTRATIVE STUDY · NOT A PATIENT SCAN</span>
  </div>
)}
