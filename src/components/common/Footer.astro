---
import Icon from './Icon.astro';
import BrandLogo from './BrandLogo.astro';
import { content } from '../../lib/content/repository';
import { createWhatsAppUrl, phoneHref, primaryPhone } from '../../lib/whatsapp';
import Arrow from './Arrow.astro';
const branches = await content.getBranches();
---

<section class="closing wrap">
  <span class="eyebrow">A LITTLE CLOSER TO YOUR NEXT STEP</span>
  <div>
    <h2>
      Let’s talk about
      <br />
      your smile.
    </h2>
    <a class="button" href={createWhatsAppUrl()} data-event="whatsapp_click">
      <span class="action-label">
        <Icon name="chat" />
        WhatsApp us
      </span>
      <Arrow diagonal />
    </a>
  </div>
  <p>Have a question? We’ll help you connect with a clinic.</p>
</section>
<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <a class="footer-brand" href="/">
        <BrandLogo variant="white" loading="lazy" />
      </a>
      <p>
        Dr Kiran’s MyDentist
        <br />
        Six locations. One place to start.
      </p>
      <a href={phoneHref(primaryPhone)} data-event="phone_click">
        <Icon name="phone" />
        {primaryPhone}
      </a>
      <a href="mailto:kiransdentalhospital@gmail.com">
        <Icon name="mail" />
        kiransdentalhospital@gmail.com
      </a>
    </div>
    <div>
      <span class="eyebrow">EXPLORE</span>
      <a href="/treatments/">Treatments</a>
      <a href="/#technology">Technology</a>
      <a href="/about/">About MyDentist</a>
      <a href="/contact/">Contact us</a>
    </div>
    <div>
      <span class="eyebrow">FIND YOUR CLINIC</span>
      {branches.map((b) => (
        <a href={`/locations/${b.slug}/`}>{b.locality}</a>
      ))}
    </div>
  </div>
  <div class="wrap footer-bottom">
    <small>© {new Date().getFullYear()} Dr Kiran’s MyDentist</small>
    <span>
      <a href="/privacy-policy/">Privacy</a>
      <a href="/terms/">Terms</a>
      <a href="#top">
        Back to top <Icon name="up" />
      </a>
    </span>
  </div>
  <div class="wrap footer-credit">
    <p class="website-credit">
      Website by <strong>Unknown</strong>
    </p>
  </div>
</footer>
