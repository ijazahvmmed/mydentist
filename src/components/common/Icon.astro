  down: ['M12 3v18m-7-7 7 7 7-7'],
  up: ['M12 21V3m-7 7 7-7 7 7'],
};
export type IconName = keyof typeof paths;
interface Props {
  name: IconName;
  class?: string;
}
const { name, class: className = '' } = Astro.props;
---

<svg
  class:list={['ui-icon', className]}
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.65"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {paths[name].map((d) => (
    <path d={d} />
  ))}
</svg>
