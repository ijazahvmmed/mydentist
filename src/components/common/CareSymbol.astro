---
interface Props {
  family: string;
}
const { family } = Astro.props;
---

<svg class="care-symbol" viewBox="0 0 96 80" fill="none" aria-hidden="true" focusable="false">
  <g stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    {family === 'restorative-endodontics' && (
      <>
        <path
          class="symbol-wash"
          d="M29 17c7-4 13 1 19 1s12-5 19-1c10 6 7 19 2 28-5 8-4 22-10 23-6 1-5-23-11-23S43 69 37 68c-6-1-5-15-10-23-5-9-8-22 2-28Z"
        />
        <path
          class="symbol-enamel"
          d="M29 17c7-4 13 1 19 1s12-5 19-1c10 6 7 17 3 25-8-3-14-5-22-5s-14 2-22 5c-4-8-7-19 3-25Z"
        />
        <path
          d="M39 20c3 2 6 5 11 5M37 50l-1 10m24-10 1 10M48 30v9m0 0-7 13m7-13 7 13"
          opacity=".55"
        />
        <path class="symbol-accent" d="m79 12 2 6 6 2-6 2-2 6-2-6-6-2 6-2 2-6Z" />
      </>
    )}
    {family === 'surgical-periodontal' && (
      <>
        <path
          class="symbol-enamel"
          d="M32 12c6-4 10 0 16 0s10-4 16 0c7 5 5 15 2 24H30c-3-9-5-19 2-24Z"
        />
        <path class="symbol-wash" d="M37 41h22l-3 25-8 7-8-7-3-25Z" />
        <path d="M33 36h30m-29 5h28M40 48l18-4m-17 12 16-4m-15 12 14-4M40 15c3 1 5 4 9 4" />
        <path class="symbol-accent" d="M17 49c0-4 3-7 7-7s7 3 7 7c0 5-7 12-7 12s-7-7-7-12Z" />
        <path d="m21 49 2 2 4-4" />
      </>
    )}
    {family === 'orthodontics' && (
      <>
        <path
          class="symbol-wash"
          d="M15 28c3 18 14 30 33 30s30-12 33-30l-8-6C70 39 62 46 48 46s-22-7-25-24l-8 6Z"
        />
        <path
          class="symbol-enamel"
          d="m24 29 2 12c1 4 6 7 9 5l-2-15-9-2Zm10 3 1 15c0 4 7 5 12 3V34l-13-2Zm14 2v16c5 2 12 1 12-3l1-15-13 2Zm15-3-2 15c3 2 8-1 9-5l2-12-9 2Z"
        />
        <path d="M21 38c14 11 40 11 54 0" />
        <path
          class="symbol-accent"
          d="M28 37h7v6h-7v-6Zm13 3h7v6h-7v-6Zm13 0h7v6h-7v-6Zm12-3h7v6h-7v-6Z"
        />
        <path d="M31 65c9 4 25 4 34 0" opacity=".5" />
      </>
    )}
    {family === 'pediatric-dentistry' && (
      <>
        <path
          class="symbol-wash"
          d="M31 19c6-3 11 1 17 1s11-4 17-1c10 5 8 16 3 25-4 8-5 20-10 21-5 0-5-17-10-17S43 65 38 65c-5-1-6-13-10-21-5-9-7-20 3-25Z"
        />
        <path
          class="symbol-enamel"
          d="M31 19c6-3 11 1 17 1s11-4 17-1c10 5 8 16 3 25-13 4-27 4-40 0-5-9-7-20 3-25Z"
        />
        <path d="M38 31v2m20-2v2m-19 5c4 6 14 6 18 0" />
        <path class="symbol-accent" d="m77 10 2 6 6 2-6 2-2 6-2-6-6-2 6-2 2-6Z" />
        <path d="M16 45v8m-4-4h8" opacity=".6" />
      </>
    )}
  </g>
</svg>
