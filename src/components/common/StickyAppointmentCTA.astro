---
import Icon from './Icon.astro';
import Arrow from './Arrow.astro';
import { createWhatsAppUrl } from '../../lib/whatsapp';

interface Props {
  href?: string;
  label?: string;
}

const { href = createWhatsAppUrl(), label = 'Book an appointment' } = Astro.props;
---

<aside class="sticky-overlay-cta" aria-label="Quick appointment booking">
  <a
    href={href}
    class="sticky-cta-button"
    data-event="whatsapp_click"
    aria-label="Book an appointment on WhatsApp"
  >
    <span class="sticky-cta-content">
      <span class="sticky-cta-icon-pill" aria-hidden="true">
        <Icon name="calendar" />
      </span>
      <span class="sticky-cta-text">{label}</span>
    </span>
    <Arrow diagonal />
  </a>
</aside>

<style>
  .sticky-overlay-cta {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 95;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transform: translateY(14px) scale(0.96);
    transition:
      opacity 0.28s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.28s cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0.28s;
  }

  .sticky-overlay-cta.is-visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }

  .sticky-cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 18px 12px 14px;
    min-height: 48px;
    border-radius: 9999px;
    background: #153f92;
    background: linear-gradient(135deg, #1847a3 0%, #103275 100%);
    color: #ffffff;
    font-family: inherit;
    font-size: 13.5px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.01em;
    text-decoration: none;
    cursor: pointer;
    box-shadow:
      0 10px 24px -4px rgba(21, 63, 146, 0.42),
      0 4px 10px -2px rgba(0, 0, 0, 0.2),
      inset 0 1px 0 rgba(255, 255, 255, 0.22);
    border: 1px solid rgba(255, 255, 255, 0.2);
    transition:
      background 0.2s ease,
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .sticky-cta-button:hover {
    background: linear-gradient(135deg, #1a4eb3 0%, #133b8a 100%);
    transform: translateY(-2px);
    box-shadow:
      0 14px 28px -4px rgba(21, 63, 146, 0.5),
      0 6px 14px -2px rgba(0, 0, 0, 0.25),
      inset 0 1px 0 rgba(255, 255, 255, 0.3);
  }

  .sticky-cta-button:active {
    transform: translateY(0);
    box-shadow:
      0 6px 14px -3px rgba(21, 63, 146, 0.4),
      0 2px 6px -1px rgba(0, 0, 0, 0.2);
  }

  .sticky-cta-button:focus-visible {
    outline: 3px solid #ffd000;
    outline-offset: 3px;
  }

  .sticky-cta-content {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .sticky-cta-icon-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.16);
    flex-shrink: 0;
  }

  .sticky-cta-icon-pill :global(.ui-icon) {
    width: 15px;
    height: 15px;
    stroke-width: 2;
  }

  .sticky-cta-text {
    white-space: nowrap;
  }

  .sticky-cta-button :global(svg:not(.ui-icon)) {
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .sticky-cta-button:hover :global(svg:not(.ui-icon)) {
    transform: translate(2px, -2px);
  }

  @media (max-width: 640px) {
    .sticky-overlay-cta {
      bottom: 16px;
      right: 16px;
    }

    .sticky-cta-button {
      padding: 11px 16px 11px 12px;
      min-height: 44px;
      font-size: 13px;
      gap: 12px;
    }

    .sticky-cta-icon-pill {
      width: 26px;
      height: 26px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sticky-overlay-cta,
    .sticky-cta-button,
    .sticky-cta-button:hover :global(svg:not(.ui-icon)) {
      transition: none;
      transform: none;
    }
  }
</style>

<script>
  function initStickyCTA() {
    const overlay = document.querySelector<HTMLElement>('.sticky-overlay-cta');
    if (!overlay) return;

    const footer = document.querySelector('footer, .site-footer');
    let isFooterVisible = false;

    function evaluateVisibility() {
      if (!overlay) return;
      const scrollPassed = window.scrollY > 160;
      if (scrollPassed && !isFooterVisible) {
        overlay.classList.add('is-visible');
      } else {
        overlay.classList.remove('is-visible');
      }
    }

    window.addEventListener('scroll', evaluateVisibility, { passive: true });

    if (footer && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            isFooterVisible = entry.isIntersecting;
            evaluateVisibility();
          });
        },
        { rootMargin: '0px 0px 40px 0px', threshold: 0.05 }
      );
      observer.observe(footer);
    }

    evaluateVisibility();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initStickyCTA);
  } else {
    initStickyCTA();
  }
</script>
