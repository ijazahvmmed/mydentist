---
import Icon from './Icon.astro';
import BrandLogo from './BrandLogo.astro';
import Arrow from './Arrow.astro';
import { createWhatsAppUrl } from '../../lib/whatsapp';
---

<header class="site-header">
  <div class="header-inner wrap">
    <a class="brand" href="/">
      <BrandLogo />
      <span class="brand-caption">
        <small>DR KIRAN’S</small>
        <span>ALAPPUZHA, KERALA</span>
      </span>
    </a>
    <button class="menu-toggle" aria-expanded="false" aria-controls="main-nav">
      Menu <Icon name="plus" />
    </button>
    <nav id="main-nav" aria-label="Main navigation">
      <a
        href="/treatments/"
        aria-current={Astro.url.pathname.startsWith('/treatments/') ? 'page' : undefined}
      >
        <Icon name="tooth" /> Treatments
      </a>
      <a
        href="/locations/"
        aria-current={Astro.url.pathname.startsWith('/locations/') ? 'page' : undefined}
      >
        <Icon name="pin" /> Our clinics
      </a>
      <a href="/#technology">
        <Icon name="scan" /> Technology
      </a>
      <a
        href="/about/"
        aria-current={Astro.url.pathname.startsWith('/about/') ? 'page' : undefined}
      >
        <Icon name="info" /> About
      </a>
      <a
        href="/contact/"
        aria-current={Astro.url.pathname.startsWith('/contact/') ? 'page' : undefined}
      >
        <Icon name="chat" /> Contact
      </a>
      <a class="button mobile-nav-cta" href={createWhatsAppUrl()} data-event="whatsapp_click">
        Let’s talk <Arrow diagonal />
      </a>
    </nav>
    <a class="button small header-cta" href={createWhatsAppUrl()} data-event="whatsapp_click">
      Let’s talk <Arrow diagonal />
    </a>
  </div>
  <span class="header-progress" aria-hidden="true"></span>
</header>
<script>
  import { gsap } from 'gsap';
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  const mobile = matchMedia('(max-width: 700px)');
  const header = document.querySelector<HTMLElement>('.site-header');
  const button = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.querySelector<HTMLElement>('#main-nav');
  const scrollPosition = () =>
    Math.max(0, Math.min(scrollY, document.documentElement.scrollHeight - innerHeight));
  let lastScroll = scrollPosition();
  let direction = 0;
  let travelled = 0;
  let scrollFrame = 0;

  function revealHeader() {
    header?.classList.remove('is-mobile-hidden');
    lastScroll = scrollPosition();
    direction = 0;
    travelled = 0;
  }

  function updateHeader() {
    scrollFrame = 0;
    const position = scrollPosition();
    const delta = position - lastScroll;
    lastScroll = position;
    if (
      !mobile.matches ||
      !header ||
      position <= header.offsetHeight + 24 ||
      nav?.classList.contains('is-open') ||
      header.querySelector(':focus-visible')
    ) {
      revealHeader();
      return;
    }
    if (!delta) return;
    const nextDirection = Math.sign(delta);
    travelled = nextDirection === direction ? travelled + Math.abs(delta) : Math.abs(delta);
    direction = nextDirection;
    // A short upward gesture reveals navigation; tiny scroll fluctuations do not toggle it.
    if (direction < 0 && travelled >= 8) header.classList.remove('is-mobile-hidden');
    if (direction > 0 && travelled >= 18) header.classList.add('is-mobile-hidden');
  }

  const onScroll = () => {
    if (!scrollFrame) scrollFrame = requestAnimationFrame(updateHeader);
  };
  addEventListener('scroll', onScroll, { passive: true });
  mobile.addEventListener('change', revealHeader);
  header?.addEventListener('focusin', revealHeader);

  function close() {
    button?.setAttribute('aria-expanded', 'false');
    nav?.classList.remove('is-open');
    revealHeader();
  }
  button?.addEventListener('click', () => {
    revealHeader();
    const expanded = button.getAttribute('aria-expanded') === 'true';
    button.setAttribute('aria-expanded', String(!expanded));
    nav?.classList.toggle('is-open', !expanded);
    if (!expanded && nav && !reduced.matches) {
      gsap.fromTo(
        nav,
        { clipPath: 'inset(0 0 100% 0)' },
        { clipPath: 'inset(0)', duration: 0.32, clearProps: 'clipPath' }
      );
      gsap.fromTo(
        nav.querySelectorAll('a'),
        { opacity: 0, x: 10 },
        { opacity: 1, x: 0, duration: 0.25, stagger: 0.035, clearProps: 'opacity,transform' }
      );
    }
  });
  nav?.querySelectorAll('a').forEach((a) => a.addEventListener('click', close));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Tab' && button?.getAttribute('aria-expanded') === 'true') {
      const links = Array.from(nav?.querySelectorAll<HTMLAnchorElement>('a') || []);
      if (e.shiftKey && document.activeElement === button) {
        e.preventDefault();
        links.at(-1)?.focus();
      } else if (!e.shiftKey && document.activeElement === links.at(-1)) {
        e.preventDefault();
        button.focus();
      }
    }
    if (e.key === 'Escape' && button?.getAttribute('aria-expanded') === 'true') {
      close();
      button.focus();
    }
  });
  document.addEventListener(
    'astro:before-swap',
    () => {
      removeEventListener('scroll', onScroll);
      mobile.removeEventListener('change', revealHeader);
      header?.removeEventListener('focusin', revealHeader);
      cancelAnimationFrame(scrollFrame);
    },
    { once: true }
  );
</script>
